      "method": "GET",
      "next_page_link": "{{ body.links.next }}",
      "next_page_termination_strategy": [
        "empty-result",
        "next-page-link-empty"
      ],
      "params": {
        "page[size]": 100
      },
      "payload_property": "audits",
      "url": "ticket_audits.json"
    },
    "ticketcomments-list": {
